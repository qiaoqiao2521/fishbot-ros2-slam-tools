<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schemens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fishbot_light_sim</name>
  <version>0.1.0</version>
  <description>FishBot 轻量 2D 仿真：栅格 raycast 雷达 + 差速里程计 + 虚拟障碍注入，复用真实地图与 Nav2 参数做导航避障算法迭代</description>
  <maintainer email="muqiao@users.noreply.github.com">muqiao</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>fishbot_description</exec_depend>
  <exec_depend>fishbot_navigation2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
