+
+TEST(RotationShimControllerTest, optInYawBandStopRetainsStoppedChecker)
+{
+  for (bool enabled : {false, true}) {
+    auto node = std::make_shared<rclcpp_lifecycle::LifecycleNode>("YawBandStopTest");
+    auto tf = std::make_shared<tf2_ros::Buffer>(node->get_clock());
+    auto listener = std::make_shared<tf2_ros::TransformListener>(*tf, node, true);
+    auto costmap = std::make_shared<nav2_costmap_2d::Costmap2DROS>("yaw_stop_costmap");
+    rclcpp_lifecycle::State state;
+    costmap->on_configure(state);
+    node->declare_parameter("PathFollower.primary_controller", std::string(
+        "nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController"));
+    node->declare_parameter("controller_frequency", 20.0);
+    node->declare_parameter("PathFollower.rotate_to_goal_heading", true);
+    node->declare_parameter("PathFollower.stop_in_goal_yaw_tolerance", enabled);
+    node->declare_parameter("PathFollower.rotate_to_heading_angular_vel", 0.055);
+    node->declare_parameter("checker.xy_goal_tolerance", 0.015);
+    node->declare_parameter("checker.yaw_goal_tolerance", 0.035);
+    node->declare_parameter("checker.trans_stopped_velocity", 0.01);
+    node->declare_parameter("checker.rot_stopped_velocity", 0.01);
+    node->declare_parameter("checker.stateful", false);
+    auto controller = std::make_shared<RotationShimShim>();
+    controller->configure(node, "PathFollower", tf, costmap);
+    controller->activate();
+    nav2_controller::StoppedGoalChecker checker;
+    checker.initialize(node, "checker", costmap);
+    geometry_msgs::msg::PoseStamped pose;
+    pose.header.frame_id = "base_link";
+    pose.pose.orientation.w = 1.0;
+    geometry_msgs::msg::Twist moving;
+    moving.angular.z = 0.04;
+    for (double angle : {-0.04, -0.02, 0.02, 0.04}) {
+      nav_msgs::msg::Path path;
+      path.header.frame_id = "base_link";
+      path.poses.resize(2, pose);
+      path.poses.back().pose.position.x = 0.005;
+      path.poses.back().pose.orientation =
+        nav2_util::geometry_utils::orientationAroundZAxis(angle);
+      controller->setPlan(path);
+      checker.reset();
+      EXPECT_FALSE(checker.isGoalReached(pose.pose, path.poses.back().pose, moving));
+      auto command = controller->computeVelocityCommands(pose, moving, &checker);
+      if (enabled && std::abs(angle) < 0.035) {
+        EXPECT_DOUBLE_EQ(command.twist.linear.x, 0.0);
+        EXPECT_DOUBLE_EQ(command.twist.angular.z, 0.0);
+      } else {
+        EXPECT_GT(std::abs(command.twist.angular.z), 0.02);
+      }
+      // A stop request is not a native success or a relaxed pose tolerance.
+      EXPECT_FALSE(checker.isGoalReached(pose.pose, path.poses.back().pose, moving));
+      checker.reset();
+      geometry_msgs::msg::Twist stopped;
+      EXPECT_EQ(checker.isGoalReached(pose.pose, path.poses.back().pose, stopped),
+        std::abs(angle) < 0.035);
+    }
+    controller->deactivate();
+    controller->cleanup();
+  }
+}
