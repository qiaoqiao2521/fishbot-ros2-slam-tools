+TEST(RotationShimControllerTest, positionCheckerUsesItsControllerNamespace)
+{
+  for (const bool stateful : {false, true}) {
+    SCOPED_TRACE(stateful);
+    auto node = std::make_shared<rclcpp_lifecycle::LifecycleNode>("ShimPositionScopeTest");
+    node->declare_parameter("FollowPath.primary_controller",
+      std::string("nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController"));
+    node->declare_parameter("FollowPath.position_checker.stateful", stateful);
+    auto tf = std::make_shared<tf2_ros::Buffer>(node->get_clock());
+    auto costmap = std::make_shared<nav2_costmap_2d::Costmap2DROS>("scope_costmap");
+    costmap->on_configure(rclcpp_lifecycle::State());
+    auto ctrl = std::make_shared<RotationShimShim>();
+    ctrl->configure(node, "FollowPath", tf, costmap);
+    EXPECT_TRUE(node->has_parameter("FollowPath.position_checker.xy_goal_tolerance"));
+    geometry_msgs::msg::Pose goal, query;
+    goal.orientation.w = query.orientation.w = 1.0;
+    query.position.x = 0.01;
+    EXPECT_TRUE(ctrl->positionReached(query, goal));
+    query.position.x = 0.019;
+    EXPECT_EQ(ctrl->positionReached(query, goal), stateful);
+    ctrl->cleanup();
+  }
+}
