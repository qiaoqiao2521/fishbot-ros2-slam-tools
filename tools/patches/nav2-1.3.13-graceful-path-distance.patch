+TEST(GracefulControllerTest, currentGoalModeResumesTranslationAfterDrift) {
+  for (const bool stateful : {true, false}) {
+    SCOPED_TRACE(stateful);
+    auto node = std::make_shared<rclcpp_lifecycle::LifecycleNode>("testGracefulCurrent");
+    node->declare_parameter("test.initial_rotation", false);
+    node->declare_parameter("checker.xy_goal_tolerance", 0.015);
+    node->declare_parameter("checker.stateful", false);
+    if (!stateful) {node->declare_parameter("test.stateful", false);}
+    auto tf = std::make_shared<tf2_ros::Buffer>(node->get_clock());
+    auto costmap = std::make_shared<nav2_costmap_2d::Costmap2DROS>("current_costmap");
+    costmap->set_parameters({
+      rclcpp::Parameter("global_frame", "test_global_frame"),
+      rclcpp::Parameter("robot_base_frame", "test_robot_frame"),
+      rclcpp::Parameter("width", 10), rclcpp::Parameter("height", 10),
+      rclcpp::Parameter("resolution", 0.1)});
+    costmap->on_configure(rclcpp_lifecycle::State());
+    auto controller = std::make_shared<GMControllerFixture>();
+    controller->configure(node, "test", tf, costmap);
+    controller->activate();
+    geometry_msgs::msg::PoseStamped robot;
+    robot.header.frame_id = "test_global_frame";
+    robot.pose.orientation.w = 1.0;
+    geometry_msgs::msg::TransformStamped transform;
+    transform.header.frame_id = robot.header.frame_id;
+    transform.child_frame_id = "test_robot_frame";
+    transform.transform.rotation.w = 1.0;
+    auto update = [&](double x) {
+        robot.pose.position.x = x;
+        robot.header.stamp = node->get_clock()->now();
+        transform.header.stamp = robot.header.stamp;
+        transform.transform.translation.x = x;
+        tf->setTransform(transform, "test", false);
+      };
+    update(0.0);
+    nav_msgs::msg::Path plan;
+    plan.header = robot.header;
+    plan.poses.push_back(robot);
+    plan.poses.back().pose.position.x = 0.01;
+    controller->setPlan(plan);
+    nav2_controller::SimpleGoalChecker checker;
+    checker.initialize(node, "checker", costmap);
+    geometry_msgs::msg::Twist velocity;
+    EXPECT_DOUBLE_EQ(controller->computeVelocityCommands(robot, velocity, &checker).twist.linear.x,
+      0.0);
+    update(-0.02);
+    EXPECT_FALSE(checker.isGoalReached(robot.pose, plan.poses.back().pose, velocity));
+    const auto cmd = controller->computeVelocityCommands(robot, velocity, &checker);
+    if (stateful) {EXPECT_DOUBLE_EQ(cmd.twist.linear.x, 0.0);}
+    else {EXPECT_GT(cmd.twist.linear.x, 0.0);}
+    controller->deactivate();
+    controller->cleanup();
+  }
+}
