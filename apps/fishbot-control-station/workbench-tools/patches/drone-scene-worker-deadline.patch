+    def _request_with_deadline(self, service, request, request_type, response_type, timeout):
+        try:
+            seconds = float(timeout)/1000.
+            if not math.isfinite(seconds):
+                raise ValueError("invalid timeout")
+            budget = max(0., seconds) + .5
+        except (TypeError, ValueError, OverflowError):
+            budget = 1.5
+            print("WARNING: invalid Gazebo request timeout; parent wait uses 1.5s", file=sys.stderr)
+        deadline = time.monotonic()+budget
+        if not self.request_lock.acquire(timeout=budget):
+            raise TimeoutError("Gazebo 请求队列等待超时")
+        try:
+            if self.worker is None:
+                self.worker = subprocess.Popen(
+                    [sys.executable, str(Path(__file__).resolve()), "--request-worker"],
+                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
+            incoming, outgoing = self.worker.stdout.fileno(), self.worker.stdin.fileno()
+            os.set_blocking(incoming, False)
+            os.set_blocking(outgoing, False)
+            data = (json.dumps({"service": service,
+                "request": request.SerializeToString().hex(),
+                "request_type": request_type.DESCRIPTOR.full_name,
+                "response_type": response_type.DESCRIPTOR.full_name, "timeout": timeout})+"\n").encode()
+            sent = 0
+            while sent < len(data):
+                remaining = deadline-time.monotonic()
+                if remaining <= 0 or not select.select([], [outgoing], [], remaining)[1]:
+                    raise TimeoutError("Gazebo 请求worker写入超时")
+                try:
+                    sent += os.write(outgoing, data[sent:])
+                except BlockingIOError:
+                    continue
+            line = b""
+            while b"\n" not in line:
+                remaining = deadline-time.monotonic()
+                if remaining <= 0 or not select.select([incoming], [], [], remaining)[0]:
+                    raise TimeoutError("Gazebo 请求worker响应超时")
+                try:
+                    chunk = os.read(incoming, 65536)
+                except BlockingIOError:
+                    continue
+                if not chunk:
+                    raise RuntimeError("Gazebo 请求进程已退出或响应不完整")
+                line += chunk
