+    def _close_request_worker(self, abort=False):
+        worker = self.worker
+        if worker is None:
+            return
+        worker.stdin.close()
+        steps = (("terminate", .2), ("kill", 1.)) if abort else ((None, 2.), ("terminate", .2), ("kill", 1.))
+        for action, grace in steps:
+            if action and worker.poll() is None:
+                try:
+                    getattr(worker, action)()
+                except ProcessLookupError:
+                    pass
+            try:
+                worker.wait(timeout=grace)
+                break
+            except subprocess.TimeoutExpired:
+                continue
+        else:
+            raise RuntimeError("Gazebo 请求worker退出未确认: "+str(worker.pid))
+        worker.stdout.close()
+        self.worker = None
