diff --git a/source_epoch_watch.py b/source_epoch_watch.py
new file mode 100644
--- /dev/null
+++ b/source_epoch_watch.py
@@ -0,0 +1,56 @@
+"""Opt-in epoch notification at the existing SDK owner; not atomic revocation."""
+import asyncio
+import time
+from urllib.parse import quote
+
+
+class SourceEpochWatch:
+    request_timeout_s = .8
+    observation_max_age_ns = 2_000_000_000
+
+    def __init__(self, request, expected_epoch, record):
+        self.request, self.expected_epoch, self.record = request, expected_epoch, record
+        self.ready = asyncio.Event()
+        self.failure, self.last_epoch, self.last_received_ns, self.task = None, None, None, None
+        record.update(expected_epoch=expected_epoch, started_monotonic_ns=time.monotonic_ns(),
+                      status="starting", observations=0)
+
+    async def run(self):
+        try:
+            while True:
+                path = "/command-epoch?after="+quote(self.last_epoch or "", safe="")
+                value = await asyncio.wait_for(asyncio.to_thread(self.request, path), self.request_timeout_s)
+                received = time.monotonic_ns()
+                epoch, observed = value.get("command_epoch"), value.get("observed_monotonic_ns")
+                if not isinstance(epoch, str) or not epoch or type(observed) is not int:
+                    raise ValueError("epoch notification metadata unavailable")
+                if not 0 <= received-observed <= self.observation_max_age_ns:
+                    raise ValueError("epoch notification observation expired")
+                self.last_epoch, self.last_received_ns = epoch, received
+                self.record.update(status="watching", latest_epoch=epoch,
+                    latest_observed_monotonic_ns=observed, latest_received_monotonic_ns=received,
+                    latest_reason=value.get("reason"), observations=self.record["observations"]+1)
+                if epoch != self.expected_epoch:
+                    self.failure = "command_source_epoch_changed"
+                elif value.get("ready") is not True:
+                    self.failure = "command_source_unready: "+str(value.get("reason"))
+                if self.failure:
+                    self.record.update(status="invalidated", failure=self.failure)
+                    return
+                self.ready.set()
+        except asyncio.CancelledError:
+            self.record["status"] = "cancelled"
+            raise
+        except Exception as error:
+            self.failure = "command_source_watch_unavailable: "+type(error).__name__+": "+str(error)
+            self.record.update(status="unavailable", failure=self.failure)
+        finally:
+            self.ready.set()
+            self.record["ended_monotonic_ns"] = time.monotonic_ns()
+
+    def check(self):
+        if self.failure:
+            raise RuntimeError(self.failure)
+        if (self.last_received_ns is None or self.task is None or self.task.done() or
+                not 0 <= time.monotonic_ns()-self.last_received_ns <= self.observation_max_age_ns):
+            raise RuntimeError("command_source_watch_unavailable")
