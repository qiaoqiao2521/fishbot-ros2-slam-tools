+    def request_line(self, payload, deadline):
+        """One framed response with the same budget for write and full read."""
+        import os
+        import select
+        incoming, outgoing = self.worker.stdout.fileno(), self.worker.stdin.fileno()
+        os.set_blocking(incoming, False)
+        os.set_blocking(outgoing, False)
+        pending = memoryview(payload.encode())
+        received = bytearray()
+        while pending or b"\n" not in received:
+            remaining = deadline-time.monotonic()
+            if remaining <= 0:
+                raise TimeoutError("Gazebo request pipe deadline exceeded")
+            readable, writable, _ = select.select(
+                [] if pending else [incoming], [outgoing] if pending else [], [], remaining)
+            try:
+                if writable:
+                    pending = pending[os.write(outgoing, pending):]
+                elif readable:
+                    chunk = os.read(incoming, 65536)
+                    if not chunk:
+                        raise RuntimeError("Gazebo 请求进程已退出")
+                    received.extend(chunk)
+            except BlockingIOError:
+                continue
