+# Decoded local-setpoint handler entry/decision, not a candidate ACK.
+# Native stamps use HRT us; wire_time_boot_ms remains sender-owned.
+uint64 timestamp
+uint64 receive_timestamp
+uint64 receiver_sequence
+uint64 setpoint_timestamp
+uint64 offboard_mode_timestamp
+uint32 wire_time_boot_ms
+float32[3] wire_position
+float32[3] wire_velocity
+float32[3] wire_acceleration
+float32[3] decoded_position
+float32[3] decoded_velocity
+float32[3] decoded_acceleration
+float32 wire_yaw
+float32 wire_yaw_rate
+uint16 type_mask
+uint8 coordinate_frame
+uint8 sender_system
+uint8 sender_component
+uint8 target_system
+uint8 target_component
+uint8 message_sequence
+uint8 receiver_channel
+uint8 nav_state
+uint8 decision
+uint8 TARGET_REJECTED = 0
+uint8 UNSUPPORTED_FRAME = 1
+uint8 UNSUPPORTED_FORCE = 2
+uint8 INVALID_TARGET = 3
+uint8 MODE_NOT_OFFBOARD = 4
+uint8 PUBLISH_CALLED = 5
