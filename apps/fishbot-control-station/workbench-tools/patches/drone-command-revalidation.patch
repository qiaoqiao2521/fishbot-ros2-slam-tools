+    async def recovery_command(self, operation, command, *args):
+        if not self.command_revalidation_enabled:
+            return await command(*args)
+        try:
+            budget = float(self.options.get("recovery_rpc_timeout_s", 1.))
+            if not math.isfinite(budget) or budget <= 0:
+                raise ValueError("invalid timeout")
+        except (TypeError, ValueError, OverflowError):
+            budget = 1.
+            self.report["errors"].append("WARNING: invalid recovery_rpc_timeout_s; using 1.0s")
+        attempt = {"operation": operation, "wait_timeout_s": budget,
+                   "started_wall_monotonic_s": time.monotonic(), "status": "pending",
+                   "remote_effect": "unknown"}
+        recovery = self.report.get("recovery") if getattr(self, "recovering", False) else None
+        attempts = (recovery.setdefault("rpc_attempts", []) if recovery is not None
+                    else self.report.setdefault("landing_rpc_attempts", []))
+        attempts.append(attempt)
+        try:
+            result = await asyncio.wait_for(command(*args), timeout=budget)
+        except asyncio.CancelledError:
+            attempt["status"] = "cancelled"
+            raise
+        except Exception as error:
+            attempt.update(status="unconfirmed", error_type=type(error).__name__, error=str(error))
+            raise RecoveryBlocked("recovery_rpc_unconfirmed: "+operation+": "+type(error).__name__) from error
+        else:
+            attempt.update(status="returned", remote_effect="not_independently_observed")
+            return result
+        finally:
+            attempt["ended_wall_monotonic_s"] = time.monotonic()
+
