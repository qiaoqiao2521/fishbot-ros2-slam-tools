+    async def await_planner_state(self, target, deadline, operator):
+        """Watch the last accepted reference while the read-only HTTP call waits."""
+        if not self.command_revalidation_enabled:
+            return await asyncio.to_thread(self.ego_request, "/state")
+        import asyncio as async_runtime
+        epoch = getattr(self.observer, "command_epoch", None)
+        clock_epoch = epoch.token if epoch is not None and epoch.enabled else None
+        started = time.monotonic()
+        def source_value(key):
+            value = self.reference.get(key)
+            return value if isinstance(value, (int, float)) and math.isfinite(value) else None
+        query = async_runtime.create_task(asyncio.to_thread(self.ego_request, "/state"))
+        try:
+            while True:
+                # A completed response must not bypass a simultaneous invalidation.
+                if self.cancel_file.exists():
+                    raise CancelFlight()
+                if operator:
+                    self.check_operator()
+                if time.monotonic() > deadline:
+                    raise TimeoutError(f"{self.phase}: 未在期限内到达三维航点")
+                if self.position_received is None or time.monotonic()-self.position_received > 3:
+                    raise RuntimeError("PX4 位姿遥测断流")
+                if self.scene.failure:
+                    raise RuntimeError("动态障碍驱动失效: "+self.scene.failure)
+                if not self.position_valid:
+                    raise RuntimeError("PX4 本地定位无效")
+                if self.observer.clock_received is None or time.monotonic()-self.observer.clock_received > 2:
+                    raise RuntimeError("simulation_clock_stopped")
+                if clock_epoch is not None and epoch.token != clock_epoch:
+                    raise RuntimeError("command_clock_epoch_changed")
+                reference = self.reference
+                if reference.get("mode") == "position_velocity_acceleration":
+                    stamp = reference.get("command_stamp_sim_s")
+                    end = reference.get("source_end_sim_s")
+                    if not all(isinstance(value, (int, float)) and math.isfinite(value)
+                               for value in (stamp, end)):
+                        raise RuntimeError("cached_command_source_unavailable")
+                    now = self.observer.simulation_s
+                    if not -.1 <= now-stamp <= .3:
+                        raise RuntimeError("cached_command_sample_expired")
+                    terminal_hold = (math.dist(reference["position"], target) <= self.position_tolerance and
+                        all(len(reference[key]) == 3 and all(abs(v) < 1e-6 for v in reference[key])
+                            for key in ("velocity", "acceleration")))
+                    if now-end > .15 and not terminal_hold:
+                        raise RuntimeError("cached_command_source_expired")
+                if query.done():
+                    return await query
+                await async_runtime.wait({query}, timeout=.02)
+        except (Exception, async_runtime.CancelledError) as error:
+            self.report.setdefault("command_wait_failures", []).append({
+                "operation": "planner_state", "outcome": "wait_rejected",
+                "reason": str(error) or type(error).__name__, "error_type": type(error).__name__,
+                "started_wall_s": started, "ended_wall_s": time.monotonic(),
+                "simulation_s": self.observer.simulation_s,
+                "reference_mode": self.reference.get("mode"),
+                "command_stamp_sim_s": source_value("command_stamp_sim_s"),
+                "source_end_sim_s": source_value("source_end_sim_s"),
+                "sdk_cache_effect": "unknown"})
+            raise
+        finally:
+            if not query.done():
+                query.cancel()
+            # Cancelling to_thread's await does not terminate its underlying thread.
+            await async_runtime.gather(query, return_exceptions=True)
+
