+    def check_command_wait(self, target, deadline, operator, clock_epoch,
+                           command=None, cached_reference=None):
+        """Use the same input and source limits during HTTP and PVA RPC waits."""
+        if self.cancel_file.exists():
+            raise CancelFlight()
+        if operator:
+            self.check_operator()
+        if time.monotonic() > deadline:
+            raise TimeoutError(f"{self.phase}: 未在期限内到达三维航点")
+        if self.position_received is None or time.monotonic()-self.position_received > 3:
+            raise RuntimeError("PX4 位姿遥测断流")
+        if self.scene.failure:
+            raise RuntimeError("动态障碍驱动失效: "+self.scene.failure)
+        if not self.position_valid:
+            raise RuntimeError("PX4 本地定位无效")
+        if self.observer.clock_received is None or time.monotonic()-self.observer.clock_received > 2:
+            raise RuntimeError("simulation_clock_stopped")
+        epoch = getattr(self.observer, "command_epoch", None)
+        if clock_epoch is not None and epoch is not None and epoch.token != clock_epoch:
+            raise RuntimeError("command_clock_epoch_changed")
+        references = [("cached_command", self.reference if cached_reference is None else cached_reference)]
+        if command is not None:
+            try:
+                end = float(command["source_end_sim_s"])
+            except (KeyError, TypeError, ValueError, OverflowError):
+                end = None
+            references.append(("inflight_command", dict(command,
+                mode="position_velocity_acceleration", command_stamp_sim_s=command.get("stamp_sim_s"),
+                source_end_sim_s=end)))
+        for label, reference in references:
+            if reference.get("mode") != "position_velocity_acceleration":
+                continue
+            stamp = reference.get("command_stamp_sim_s")
+            end = reference.get("source_end_sim_s")
+            if not all(isinstance(value, (int, float)) and math.isfinite(value)
+                       for value in (stamp, end)):
+                raise RuntimeError(label+"_source_unavailable")
+            now = self.observer.simulation_s
+            if not -.1 <= now-stamp <= .3:
+                raise RuntimeError(label+"_sample_expired")
+            terminal_hold = (math.dist(reference["position"], target) <= self.position_tolerance and
+                all(len(reference[key]) == 3 and all(abs(v) < 1e-6 for v in reference[key])
+                    for key in ("velocity", "acceleration")))
+            if now-end > .15 and not terminal_hold:
+                raise RuntimeError(label+"_source_expired")
+
+    async def await_pva_command(self, command, target, deadline, operator):
+        if not self.command_revalidation_enabled:
+            return await self.setpoint(command["position"], command["yaw_rad"],
+                                       command["velocity"], command["acceleration"])
+        import asyncio as async_runtime
+        try:
+            budget = float(getattr(self, "options", {}).get("command_rpc_timeout_s", 1.))
+            if not math.isfinite(budget) or budget <= 0:
+                raise ValueError("invalid timeout")
+        except (TypeError, ValueError, OverflowError):
+            budget = 1.
+            self.report.setdefault("errors", []).append("WARNING: invalid command_rpc_timeout_s; using 1.0s")
+        epoch = getattr(self.observer, "command_epoch", None)
+        clock_epoch = epoch.token if epoch is not None and epoch.enabled else None
+        previous = self.reference
+        loop = async_runtime.get_running_loop()
+        expires = loop.time()+budget
+        attempt = {"operation": "pva", "status": "pending", "remote_effect": "unknown",
+                   "wait_timeout_s": budget, "started_wall_monotonic_s": time.monotonic()}
+        self.report.setdefault("command_rpc_attempts", []).append(attempt)
+        send = None
+        try:
+            self.check_command_wait(target, deadline, operator, clock_epoch, command, previous)
+            send = async_runtime.create_task(self.setpoint(command["position"], command["yaw_rad"],
+                                                         command["velocity"], command["acceleration"]))
+            while True:
+                # A response cannot override an invalidation in the same event-loop turn.
+                self.check_command_wait(target, deadline, operator, clock_epoch, command, previous)
+                remaining = expires-loop.time()
+                if remaining <= 0:
+                    raise TimeoutError("command_rpc_timeout")
+                if send.done():
+                    result = await send
+                    attempt.update(status="returned", remote_effect="not_independently_observed")
+                    return result
+                await async_runtime.wait({send}, timeout=min(.02, remaining))
+        except (Exception, async_runtime.CancelledError) as error:
+            attempt.update(status="cancelled" if isinstance(error, async_runtime.CancelledError) else "unconfirmed",
+                           reason=str(error) or type(error).__name__, error_type=type(error).__name__)
+            raise
+        finally:
+            attempt["rpc_returned"] = (send is not None and send.done() and not send.cancelled()
+                                        and send.exception() is None)
+            if send is not None:
+                if not send.done():
+                    send.cancel()
+                # Cancelling the client wait is not a remote cache rollback.
+                await async_runtime.gather(send, return_exceptions=True)
+            attempt["ended_wall_monotonic_s"] = time.monotonic()
+
+    async def await_planner_state(self, target, deadline, operator):
+        """Watch the last accepted reference while the read-only HTTP call waits."""
+        if not self.command_revalidation_enabled:
+            return await asyncio.to_thread(self.ego_request, "/state")
+        import asyncio as async_runtime
+        epoch = getattr(self.observer, "command_epoch", None)
+        clock_epoch = epoch.token if epoch is not None and epoch.enabled else None
+        started = time.monotonic()
+        def source_value(key):
+            value = self.reference.get(key)
+            return value if isinstance(value, (int, float)) and math.isfinite(value) else None
+        query = async_runtime.create_task(asyncio.to_thread(self.ego_request, "/state"))
+        try:
+            while True:
+                self.check_command_wait(target, deadline, operator, clock_epoch)
+                if query.done():
+                    return await query
+                await async_runtime.wait({query}, timeout=.02)
+        except (Exception, async_runtime.CancelledError) as error:
+            self.report.setdefault("command_wait_failures", []).append({
+                "operation": "planner_state", "outcome": "wait_rejected",
+                "reason": str(error) or type(error).__name__, "error_type": type(error).__name__,
+                "started_wall_s": started, "ended_wall_s": time.monotonic(),
+                "simulation_s": self.observer.simulation_s,
+                "reference_mode": self.reference.get("mode"),
+                "command_stamp_sim_s": source_value("command_stamp_sim_s"),
+                "source_end_sim_s": source_value("source_end_sim_s"),
+                "sdk_cache_effect": "unknown"})
+            raise
+        finally:
+            if not query.done():
+                query.cancel()
+            # Cancelling to_thread's await does not terminate its underlying thread.
+            await async_runtime.gather(query, return_exceptions=True)
+
