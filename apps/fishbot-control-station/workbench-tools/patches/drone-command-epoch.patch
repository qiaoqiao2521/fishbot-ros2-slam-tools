+                curve, begin, duration = info['curve'],info['begin'],info['duration']
+                expected = [curve(begin+min(t,duration)),curve.derivative()(begin+t) if t<duration else [0.,0.,0.],
+                    curve.derivative(2)(begin+t) if t<duration else [0.,0.,0.]]
