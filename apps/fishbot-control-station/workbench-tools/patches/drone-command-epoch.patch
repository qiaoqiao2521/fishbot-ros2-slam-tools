+                info = self.curves.get(identity)
+                if info is None:
+                    self.counts['ignored'] += 1
+                    return
+                source_ns = event['source_stamp_ns']
+                message = Obj(trajectory_id=identity,header=Obj(stamp=self.stamp(source_ns)),
+                    **{k:self.vector(body[k]) for k in ('position','velocity','acceleration')},yaw=body['yaw'])
+                if not math.isfinite(message.yaw):raise ValueError('yaw')
