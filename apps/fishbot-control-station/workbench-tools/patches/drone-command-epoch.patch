+                  "position": "/drone/ego/position_cmd"}
+        observed, reason = {}, None
+        try:
+            for kind, topic in topics.items():
+                observed[kind] = sorted((entry.node_name, entry.node_namespace,
+                    bytes(entry.endpoint_gid).hex()) for entry in self.get_publishers_info_by_topic(topic))
