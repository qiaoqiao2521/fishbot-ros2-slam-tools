+                curve_info = dict(curve=curve,source_ns=source_ns,begin=begin,duration=end-begin,receipt=receipt)
+            else:
+                identity = body['trajectory_id']
+                if type(identity) is not int or identity < 0:raise ValueError('trajectory_id')
+                if not node.active_goal or not node.goal_acknowledged or identity < node.min_trajectory_id or identity not in node.trajectory_times:
+                    self.counts['ignored'] += 1
