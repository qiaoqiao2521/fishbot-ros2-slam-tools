+
+    def poll(self, node):
+        if self.process is None or self.process.poll() is not None:
+            if node.active_goal or node.setpoint:self.reject(node,'native_receipt_process_unavailable')
+            return
+        try:
+            with self.path.open('rb') as stream:
+                if stream.seek(0,2) < self.offset:
+                    self.offset,self.fragment=0,b''
+                    self.reject(node,'native_receipt_stream_restarted')
+                stream.seek(self.offset)
+                chunk=stream.read(1024*1024)
+                self.offset=stream.tell()
+            lines=(self.fragment+chunk).split(b'\n');self.fragment=lines.pop()
+            for line in lines:
+                if not line.startswith(b'{'):
+                    self.counts['log_lines'] += bool(line)
+                    continue
+                try:self.feed(node,json.loads(line))
+                except (json.JSONDecodeError,UnicodeDecodeError):self.reject(node,'native_receipt_invalid_json')
+        except OSError as error:
+            self.reject(node,'native_receipt_stream_unavailable: '+type(error).__name__)
