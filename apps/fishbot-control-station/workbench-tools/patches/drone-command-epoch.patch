new file mode 100644
--- /dev/null
+++ b/native_receipts.py
@@ -0,0 +1,193 @@
+"""Opt-in local C++ receipt ingress; not a native goal/session or flight proof."""
+import json
+import math
+from pathlib import Path
+import time
+from types import SimpleNamespace as Obj
+
+from scipy.interpolate import BSpline
+
+
+class NativeReceipts:
+    # Numerical identity of two evaluations, not a flight acceptance tolerance.
+    pva_numeric_tolerance = 1e-6
+
+    def __init__(self, path, clock_ns=None):
+        self.path, self.process = Path(path), None
+        self.clock_ns = clock_ns or time.monotonic_ns
+        self.started_ns = self.clock_ns()
+        self.offset, self.fragment = 0, b''
+        self.heartbeat_ns, self.publisher_counts = None, {}
+        self.error, self.last_error = None, None
+        self.last_epoch, self.ack_receipt = None, None
+        self.curves, self.sequences = {}, {}
+        self.counts = dict(admitted_ack=0, admitted_bspline=0, admitted_position=0,
+                           rejected=0, ignored=0, log_lines=0)
+
+    def reason(self):
+        if self.process is None or self.process.poll() is not None:
+            return 'native_receipt_process_unavailable'
+        if self.heartbeat_ns is None:
+            return 'native_receipt_waiting'
+        if not 0 <= self.clock_ns()-self.heartbeat_ns <= 2_000_000_000:
+            return 'native_receipt_stale'
+        if any(self.publisher_counts.get(k) != 1 for k in ('ack','bspline','position')):
+            return 'native_receipt_connections_unready'
+        return self.error
+
+    def diagnostics(self):
+        return dict(reason=self.reason(), last_error=self.last_error, counts=dict(self.counts),
+                    publisher_counts=dict(self.publisher_counts), heartbeat_ns=self.heartbeat_ns, started_ns=self.started_ns,
+                    scope='C++ per-message source admission and PVA identity; upstream acceptance/session unproven')
+
+    def reject(self, node, reason):
+        self.counts['rejected'] += 1
+        if self.error != reason or node.active_goal or node.setpoint:
+            node.invalidate_command_source(reason)
+        self.error = self.last_error = reason
+        self.curves.clear()
+
+    def sync_epoch(self, node):
+        if self.last_epoch != node.command_epoch.token:
+            self.curves.clear()
+            self.ack_receipt = None
+            self.last_epoch = node.command_epoch.token
+
+    @staticmethod
+    def stamp(value):
+        if type(value) is not int or value < 0:
+            raise ValueError('source_stamp_ns')
+        return Obj(sec=value//1_000_000_000, nanosec=value%1_000_000_000)
+
+    @staticmethod
+    def vector(value):
+        if len(value) != 3 or not all(type(x) in (int,float) and math.isfinite(x) for x in value):
+            raise ValueError('vector')
+        return Obj(x=value[0],y=value[1],z=value[2])
+
+    def feed(self, node, event):
+        """Consume the original envelope; never refresh its source or receipt times."""
+        try:
+            self.sync_epoch(node)
+            kind, received = event['kind'], event['host_monotonic_ns']
+            if type(received) is int and received < self.started_ns:
+                self.counts['ignored'] += 1
+                return
+            if type(received) is not int or not 0 <= self.clock_ns()-received <= 2_000_000_000:
+                raise ValueError('receipt_age')
+            if kind == 'heartbeat':
+                self.heartbeat_ns = received
+                self.publisher_counts = dict(event['publisher_counts'])
+                if all(self.publisher_counts.get(k)==1 for k in ('ack','bspline','position')):
+                    self.error = None
+                return
+            if kind not in ('ack','bspline','position'):
+                raise ValueError('kind')
+            if not node.observe_source_graph():
+                self.counts['ignored'] += 1
+                return
+            bindings = node.source_graph_endpoints
+            gid = event['publisher_gid']
+            if gid != bindings[kind][0][2]:
+                self.reject(node, 'native_receipt_source_mismatch_'+kind)
+                return
+            sequence = event['publication_sequence_number']
+            if type(sequence) is not int or sequence < 0 or type(event['source_timestamp']) is not int or event['source_timestamp'] <= 0:
+                raise ValueError('dds_metadata')
+            key = (kind,gid)
+            self.sequences = {k:v for k,v in self.sequences.items() if k[1] in {x[0][2] for x in bindings.values()}}
+            if sequence <= self.sequences.get(key,-1):
+                self.counts['ignored'] += 1
+                return
+            self.sequences[key] = sequence
+            body = event['message']
+            receipt = {k:event[k] for k in ('publisher_gid','host_monotonic_ns','source_timestamp','publication_sequence_number')}
+            epoch = node.command_epoch.token
+            curve_info = None
