diff --git a/command_epoch.py b/command_epoch.py
new file mode 100644
--- /dev/null
+++ b/command_epoch.py
@@ -0,0 +1,38 @@
+"""Opt-in local candidate epochs; not a native ROS or SDK cancellation token."""
+import os
+import uuid
+
+
+class CommandEpoch:
+    def __init__(self):
+        self.enabled = os.environ.get("DRONE_COMMAND_EPOCH") == "1"
+        self.token = str(uuid.uuid4())
+        self.last_sim = self.progress_wall = None
+        self.stalled = False
+        self.reason = "initial"
+        self.goal_stamp_floor = 0
+
+    def rotate(self, reason):
+        self.token, self.reason = str(uuid.uuid4()), reason
+
+    def next_goal_stamp(self, proposed):
+        # Native ACK echoes this correlation stamp, not the HTTP UUID.
+        self.goal_stamp_floor = max(proposed, self.goal_stamp_floor+1)
+        return self.goal_stamp_floor
+
+    def observe(self, now, wall):
+        if not self.enabled:
+            return None
+        changed = self.last_sim is None or now != self.last_sim
+        reason = None
+        if self.last_sim is not None and now < self.last_sim:
+            reason = "clock_rewind"
+        elif self.progress_wall is not None and wall-self.progress_wall > 2 and not self.stalled:
+            reason = "clock_stalled"
+        if reason:
+            self.rotate(reason)
+            self.stalled = True
+        if changed:
+            self.progress_wall, self.stalled = wall, False
+        self.last_sim = now
+        return reason
