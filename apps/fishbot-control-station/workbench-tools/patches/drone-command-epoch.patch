+        except Exception as error:
+            reason = "source_graph_unavailable"
+            observed["error"] = type(error).__name__+": "+str(error)
+        binding = None if reason else observed
+        previous = getattr(self, "source_graph_endpoints", None)
+        if not reason and previous is not None and binding != previous:
+            reason = "source_graph_changed"
+        if reason:
+            signature = (reason, repr(observed))
+            if signature != getattr(self, "source_graph_failure_signature", None):
