diff --git a/msg/PositionControlHandoff.msg b/msg/PositionControlHandoff.msg
new file mode 100644
--- /dev/null
+++ b/msg/PositionControlHandoff.msg
@@ -0,0 +1,29 @@
+# Diagnostic observation of one mc_pos_control cycle, not a sender identity ACK.
+# NED position [m], velocity [m/s], acceleration [m/s^2], yaw [rad].
+# uint64 stamps are native PX4 HRT microseconds; no sim-clock conversion implied.
+uint64 timestamp
+uint64 state_sample_timestamp
+uint64 raw_input_timestamp
+uint64 used_input_timestamp
+uint64 output_timestamp
+float32[3] raw_position
+float32[3] raw_velocity
+float32[3] raw_acceleration
+float32[3] used_position
+float32[3] used_velocity
+float32[3] used_acceleration
+float32[3] output_position
+float32[3] output_velocity
+float32[3] output_acceleration
+float32 raw_yaw
+float32 used_yaw
+bool input_updated
+bool raw_input_available
+bool pre_control_failsafe # generated in this cycle
+bool used_local_failsafe # provenance, including retained/old locally generated input
+uint8 update_attempts
+uint8 update_success_mask # bit n: update attempt n+1 succeeded
+uint8 used_branch
+uint8 PRIMARY = 0 # primary path; external source is unknown, post-EKF/takeoff adjustments
+uint8 OLD_INPUT = 1
+uint8 FAILSAFE = 2
diff --git a/src/modules/mc_pos_control/MulticopterPositionControl.hpp b/src/modules/mc_pos_control/MulticopterPositionControl.hpp
