+                handoff_observation.raw_velocity[i] = handoff_raw_input.velocity[i];
+                handoff_observation.raw_acceleration[i] = handoff_raw_input.acceleration[i];
+                handoff_observation.used_position[i] = handoff_used_input.position[i];
+                handoff_observation.used_velocity[i] = handoff_used_input.velocity[i];
+                handoff_observation.used_acceleration[i] = handoff_used_input.acceleration[i];
+            }
+            handoff_observation.output_position[0] = local_pos_sp.x;
+            handoff_observation.output_position[1] = local_pos_sp.y;
+            handoff_observation.output_position[2] = local_pos_sp.z;
+            handoff_observation.output_velocity[0] = local_pos_sp.vx;
+            handoff_observation.output_velocity[1] = local_pos_sp.vy;
+            handoff_observation.output_velocity[2] = local_pos_sp.vz;
+            handoff_observation.output_acceleration[0] = local_pos_sp.acceleration[0];
+            handoff_observation.output_acceleration[1] = local_pos_sp.acceleration[1];
+            handoff_observation.output_acceleration[2] = local_pos_sp.acceleration[2];
+            _handoff_observation_pub.publish(handoff_observation);
