diff --git a/handoff_observation.py b/handoff_observation.py
new file mode 100644
--- /dev/null
+++ b/handoff_observation.py
@@ -0,0 +1,46 @@
+"""Optional sender observations. RPC return is not a PX4 consumption ACK."""
+import json
+import os
+import sys
+import time
+import uuid
+from pathlib import Path
+
+
+class HandoffObservation:
+    def __init__(self, path, task_id):
+        self.path = Path(path)
+        self.task_id = task_id
+        self.session = str(uuid.uuid4())
+        self.sequence = 0
+        self.warning_reported = False
+
+    @classmethod
+    def from_environment(cls, output, task_id):
+        if os.environ.get("DRONE_TRACE_HANDOFF") != "1":
+            return None
+        return cls(Path(output)/"handoff-sender.jsonl", task_id)
+
+    def emit(self, stage, sequence, simulation_s, **fields):
+        # Diagnostic failures never replace an SDK failure or cancellation.
+        try:
+            row = dict(fields, stage=stage, rpc_call_seq=sequence,
+                       task_id=self.task_id, trace_session_id=self.session,
+                       host_monotonic_ns=time.monotonic_ns(),
+                       source_simulation_s=simulation_s,
+                       source_clock="gazebo_sim_time", source_epoch=None,
+                       actual_execution_admission="unqualified_observation")
+            line = json.dumps(row, ensure_ascii=False, allow_nan=False)
+            with self.path.open("a", encoding="utf-8") as stream:
+                stream.write(line+"\n")
+        except Exception as error:
+            if not self.warning_reported:
+                self.warning_reported = True
+                try:
+                    print("WARNING: handoff observation unavailable: "+type(error).__name__, file=sys.stderr)
+                except Exception:
+                    pass
+
+    def next_sequence(self):
+        self.sequence += 1
+        return self.sequence
