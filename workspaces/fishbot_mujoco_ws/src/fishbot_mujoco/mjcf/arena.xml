<?xml version="1.0" encoding="utf-8"?>
<mujoco model="fishbot_synthetic_arena">
  <include file="fishbot.xml"/>
  <!-- Synthetic public fixture: 8 m square, a central block, and two separated baffles. -->
  <visual><global azimuth="120" elevation="-30"/><rgba rangefinder="1 1 0.1 0"/></visual>
  <asset>
    <texture name="floor_grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.70 0.72 0.75" rgb2="0.82 0.84 0.87"/>
    <material name="floor_material" texture="floor_grid" texrepeat="8 8" texuniform="true"/>
  </asset>
  <worldbody>
    <light name="arena_light" pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_material"/>
    <geom name="wall_north" type="box" pos="0 4 0.30" size="4.10 0.10 0.30" rgba="0.75 0.75 0.80 1"/>
    <geom name="wall_south" type="box" pos="0 -4 0.30" size="4.10 0.10 0.30" rgba="0.75 0.75 0.80 1"/>
    <geom name="wall_east" type="box" pos="4 0 0.30" size="0.10 4.10 0.30" rgba="0.75 0.75 0.80 1"/>
    <geom name="wall_west" type="box" pos="-4 0 0.30" size="0.10 4.10 0.30" rgba="0.75 0.75 0.80 1"/>
    <geom name="block" type="box" pos="1.30 0.50 0.25" size="0.30 0.30 0.25" rgba="0.90 0.45 0.15 1"/>
    <geom name="baffle_left" type="box" pos="-1.40 1.20 0.25" size="0.10 0.80 0.25" rgba="0.35 0.55 0.75 1"/>
    <geom name="baffle_right" type="box" pos="1.40 -1.40 0.25" size="0.80 0.10 0.25" rgba="0.35 0.55 0.75 1"/>
    <!-- External actor: real contact and laser geometry; excluded from the fixture map. -->
    <body name="moving_obstacle" pos="-0.70 -0.70 0.222">
      <freejoint name="moving_obstacle_free_joint"/>
      <geom name="moving_obstacle_collision" type="box" size="0.18 0.18 0.22"
            mass="2.0" friction="0.8 0.005 0.0001" rgba="0.88 0.12 0.28 1"/>
    </body>
    <camera name="arena_overview" pos="0 -6 5" xyaxes="1 0 0 0 0.6401844 0.7682213"/>
  </worldbody>
</mujoco>
